# Set to the live domain on Vercel (e.g. https://earnloop-kappa.vercel.app).
# If left as localhost, magic-link emails will point at localhost. Falls back to Vercel-provided URL vars.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=EarnLoop

# Umami analytics. Set the website ID to the production site (was hardcoded as 186f0763-9f17-4313-b832-5e24c0f3f1ca in the old homepage). Omit to disable tracking.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Omniroute API: sk-d1484e0b951c161b-96eb1b-5ee0ca35
# Comma-separated, lowercase email allowlist for CMS administrators.
# Enforce this server-side after Supabase Auth; never read it in client components.
ADMIN_EMAILS=owner@example.com
# Add ${NEXT_PUBLIC_SITE_URL}/auth/callback to Supabase Auth redirect URLs.

OPENAI_API_KEY=
GEMINI_API_KEY=

# Web ads (AdSense). Leave empty to render labeled placeholders.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Optional per-slot IDs for the three placements (leaderboard, in-article, sidebar).
# See Admin → Ads for the setup guide.
NEXT_PUBLIC_ADSENSE_SLOT_LEADERBOARD=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
# Future native app only — do not load in the browser.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=

# Optional announce targets for admin "Share" actions
DISCORD_WEBHOOK_URL=
